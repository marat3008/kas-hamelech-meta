# ===================================================
# קובץ הגדרות - כס המלך עיצובים
# ===================================================
# הוראות: מלא את הערכים הבאים עם הפרטים שלך
# אחרי שמילאת, שמור את הקובץ בשם: .env
# ===================================================

# --- WhatsApp ---
# מספר ה-ID של מספר הטלפון שלך ב-WhatsApp Business
WA_PHONE_NUMBER_ID=כתוב_כאן_את_ה_ID

# סיסמת המערכת שלך ב-Meta
WA_SYSTEM_USER_TOKEN=כתוב_כאן_את_הסיסמה

# מזהה חשבון ה-WhatsApp Business שלך
WA_BUSINESS_ACCOUNT_ID=כתוב_כאן_את_ה_ID

# --- Facebook & Instagram ---
# מזהה העמוד שלך בפייסבוק
FB_PAGE_ID=כתוב_כאן

# סיסמת גישה לעמוד פייסבוק
FB_PAGE_ACCESS_TOKEN=כתוב_כאן

# מזהה חשבון הפרסום שלך
FB_AD_ACCOUNT_ID=כתוב_כאן

# --- Meta App Settings ---
# מזהה האפליקציה שיצרת ב-Meta Developers
META_APP_ID=כתוב_כאן

# סיסמת האפליקציה (App Secret) - נמצאת ב-Meta Developers
META_APP_SECRET=כתוב_כאן

# מילת סיסמה שאתה בוחר לאימות ה-Webhook (תבחר כל מילה שתרצה)
META_VERIFY_TOKEN=כסהמלך2024

# מזהה הפיקסל שלך למעקב המרות
META_PIXEL_ID=כתוב_כאן

# סיסמת CAPI - למעקב המרות
META_CAPI_TOKEN=כתוב_כאן

# מזהה העסק שלך ב-Meta Business
META_BUSINESS_ID=כתוב_כאן

# --- הגדרות השרת ---
PORT=3000
NODE_ENV=production

# כתובת האתר שלך (לאחר שפרסת את השרת)
SERVER_URL=https://your-server-url.com

# --- הגדרות מסד נתונים (Postgres) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kas_hamelech
DB_USER=admin
DB_PASSWORD=בחר_סיסמה_חזקה

# --- Redis (לתורי הודעות) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- התראות אימייל ---
# האימייל שיקבל התראות על לידים חדשים
ALERT_EMAIL=your@email.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password

# --- הגדרות עסק ---
BUSINESS_NAME=כס המלך עיצובים
BUSINESS_PHONE=972-XX-XXXXXXX
