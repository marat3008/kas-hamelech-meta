# ===================================================
# הגדרות — כס המלך עיצובים
# העתק קובץ זה ל-.env ומלא את הערכים
# ===================================================

# --- פייסבוק ---
# מזהה עמוד הפייסבוק שלך (נמצא ב-About של הדף)
FB_PAGE_ID=

# Page Access Token (Meta Business Suite > Settings > Page Access Token)
FB_PAGE_ACCESS_TOKEN=

# --- אינסטגרם ---
# Instagram User ID (שונה מ-username — נמצא ב-Meta Graph Explorer)
# GET /{page-id}?fields=instagram_business_account
IG_USER_ID=

# --- Meta Webhook ---
# מילת סיסמה לאימות Webhook (בחר כל מחרוזת)
META_VERIFY_TOKEN=keshamelech2024

# App Secret מ-Meta Developers
META_APP_SECRET=

# --- פרסום אוטונומי ---
# true = מפעיל scheduler אוטומטית עם עליית השרת
AUTO_PUBLISH=true

# URL של תמונה ברירת מחדל לפוסטים (אופציונלי)
# אם לא מוגדר — פוסטי פייסבוק יפורסמו כטקסט בלבד
# אינסטגרם דורש תמונה — ללא URL לא יפורסם
DEFAULT_POST_IMAGE_URL=

# --- טיקטוק ---
# Access Token מ-TikTok Developer Portal (apps.tiktok.com)
# שלבים: Developer Portal > App > Products > Content Posting API > Generate Token
# נדרש scope: video.publish, video.upload
TIKTOK_ACCESS_TOKEN=

# רמת פרטיות: PUBLIC_TO_EVERYONE | MUTUAL_FOLLOW_FRIENDS | SELF_ONLY
TIKTOK_PRIVACY=PUBLIC_TO_EVERYONE

# URL של וידאו ברירת מחדל לפוסטי טיקטוק (אופציונלי — ניתן גם להשתמש בתמונה)
DEFAULT_POST_VIDEO_URL=

# --- Buffer (אופציונלי — אם רוצים לתזמן דרך Buffer) ---
BUFFER_ACCESS_TOKEN=
BUFFER_FB_PROFILE_ID=
BUFFER_IG_PROFILE_ID=

# --- Composio (חיבור גרישה לכלי Meta Ads / WhatsApp) ---
# Project API Key מ-Composio: Settings > Project Settings > API Keys
COMPOSIO_API_KEY=

# --- שרת ---
PORT=3000
NODE_ENV=production
